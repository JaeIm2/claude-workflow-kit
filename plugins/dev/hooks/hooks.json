{
  "description": "push-guard: ask the user before any git push",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/push-guard.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
